# CampusCare Backend Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=campuscare-super-secure-secret-key-2026-mca
JWT_SECRET_KEY=campuscare-jwt-secret-token-key-2026-mca
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database Configuration (MySQL 8)
# If MySQL is running, CampusCare connects to MySQL 8.
# If not yet running or credentials fail, it safely falls back to local SQLite for instant evaluation.
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campuscare
DB_USER=root
DB_PASSWORD=

# Upload Storage Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760 # 10 MB Max Request Size
